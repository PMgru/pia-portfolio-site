# ─── Site URL ──────────────────────────────────────────────────────────────
# Used by getServerSideProps to self-call API routes for SSR SEO metadata.
# For local development: http://localhost:3000
# For production (Netlify/Vercel): set to your actual live domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── JWT Secret ────────────────────────────────────────────────────────────
# CRITICAL: Change this to a long random string in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# ─── Admin Credentials ─────────────────────────────────────────────────────
# These are read on first boot to seed the admin user in db.json.
# After the user is created, these are no longer used.
ADMIN_EMAIL=admin@pialmahmud.com
ADMIN_PASSWORD=YourSecurePasswordHere
